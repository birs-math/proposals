 <div class="modal fade" id="cloneProposalForm<%= @proposal_type.id %>" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content" style="max-height: 550px; overflow-y: auto;">
      <div class="modal-header">
        <h5 class="modal-title">Clone a Proposal Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body m-3">
        <% ProposalForm.unscoped.where(proposal_type_id: @proposal_type.id).order(status: :asc, updated_at: :desc).each do |proposal_form| %>
          <div class="card mb-2">
            <div class="card-body py-2">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <span class="fw-bold"><%= proposal_form.title %></span>
                  <span class="text-muted ms-2">#<%= proposal_form.id %></span><br>
                  <small>
                    <% badge_class = proposal_form.active? ? 'bg-success' : proposal_form.draft? ? 'bg-secondary' : 'bg-light text-dark border' %>
                    <span class="badge <%= badge_class %>"><%= proposal_form.status.capitalize %></span>
                    <span class="ms-2">Last edited: <%= proposal_form.updated_at.strftime("%Y-%m-%d") %></span>
                  </small>
                </div>
                <%= link_to 'Clone', clone_proposal_type_proposal_form_path(@proposal_type, proposal_form), class: 'btn btn-sm btn-primary', method: :post %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
