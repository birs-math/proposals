<main class="content">
  <div class="container-fluid">
    <div class="header">
      <h1 class="header-title">Confirm Edit</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Dashboard", dashboards_path %></li>
          <li class="breadcrumb-item"><%= link_to "Proposal Types", proposal_types_path %></li>
          <li class="breadcrumb-item"><%= link_to @proposal_type.name, proposal_type_proposal_forms_path(@proposal_type) %></li>
          <li class="breadcrumb-item active">Confirm Edit</li>
        </ol>
      </nav>
    </div>

    <div class="col-lg-12">
      <div class="alert alert-danger" role="alert">
        <strong>Warning: this is a destructive action.</strong> Editing an active form cannot be undone from the UI.
        Proceeding will:
        <ul class="mb-0 mt-2">
          <li>Create a new draft copy of <strong><%= @proposal_form.title %></strong> (ID #<%= @proposal_form.id %>) for you to edit</li>
          <li>Deactivate the current form immediately</li>
          <li>Update the <%= pluralize(@stale_count, 'draft proposal') %> listed below to reference the new form — their existing answers will carry over, but:
            <ul class="mt-1">
              <li><strong>Adding a required field</strong> — migrated drafts will be missing it and cannot be submitted until filled in</li>
              <li><strong>Deleting a field</strong> — any answer already saved to that field is permanently lost</li>
              <li><strong>Removing options from a dropdown or checkbox group</strong> — drafts that selected a removed option will display a blank or invalid value</li>
              <li><strong>Making an optional field required</strong> — drafts that left it blank will fail validation on submission</li>
            </ul>
          </li>
        </ul>
      </div>

      <div class="card mb-3">
        <table class="table table-sm mb-0">
          <thead>
            <tr><th>Code</th><th>Title</th><th>Last modified</th></tr>
          </thead>
          <tbody>
            <% @proposals_to_lock.order(updated_at: :desc).each do |p| %>
              <tr>
                <td><%= link_to p.code, submitted_proposal_path(p), target: '_blank' %></td>
                <td><%= p.title %></td>
                <td><%= p.updated_at.strftime("%Y-%m-%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <label for="confirm-input" class="form-label fw-bold">Type <code>CONFIRM</code> to proceed:</label>
          <input type="text" id="confirm-input" class="form-control" placeholder="CONFIRM" autocomplete="off"
                 oninput="document.getElementById('confirm-edit-btn').disabled = this.value !== 'CONFIRM'">
        </div>
      </div>

      <%= form_with url: edit_proposal_type_proposal_form_path(@proposal_type, @proposal_form), method: :get, data: { turbo: false } do |f| %>
        <%= hidden_field_tag :confirmed, 1 %>
        <div class="d-flex gap-2">
          <%= f.submit "Proceed — clone form and update #{@stale_count} draft proposal(s)",
                id: 'confirm-edit-btn',
                class: 'btn btn-danger',
                disabled: true %>
          <%= link_to "Export CSV", export_stale_drafts_proposal_type_proposal_form_path(@proposal_type, @proposal_form), class: 'btn btn-outline-secondary' %>
          <%= link_to "Cancel", proposal_type_proposal_forms_path(@proposal_type), class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
  </div>
</main>
