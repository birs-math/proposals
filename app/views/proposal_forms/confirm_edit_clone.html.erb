<main class="content">
  <div class="container-fluid">
    <div class="header">
      <h1 class="header-title">Confirm Edit</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Dashboard", dashboards_path %></li>
          <li class="breadcrumb-item"><%= link_to "Proposal Types", proposal_types_path %></li>
          <li class="breadcrumb-item"><%= link_to @proposal_type.name, proposal_type_proposal_forms_path(@proposal_type) %></li>
          <li class="breadcrumb-item active">Confirm Edit</li>
        </ol>
      </nav>
    </div>

    <div class="col-lg-8">
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Action required: draft proposals will be locked</h4>
        <p>Editing an active form creates a new version and deactivates the current one. <%= t('proposal_forms.stale_drafts.locked_notice', count: @stale_count) %> Their authors will see a message asking them to start a new proposal.</p>
        <p><strong>This cannot be undone from the UI.</strong> Please confirm you wish to proceed.</p>
      </div>

      <div class="d-flex gap-2">
        <%= link_to "Confirm — edit form and lock #{@stale_count} draft proposal(s)",
              edit_proposal_type_proposal_form_path(@proposal_type, @proposal_form, confirmed: 1),
              class: 'btn btn-danger' %>
        <%= link_to "Cancel", proposal_type_proposal_forms_path(@proposal_type), class: 'btn btn-secondary' %>
      </div>
    </div>
  </div>
</main>
