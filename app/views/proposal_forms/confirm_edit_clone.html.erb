<main class="content">
  <div class="container-fluid">
    <div class="header">
      <h1 class="header-title">Confirm Edit</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Dashboard", dashboards_path %></li>
          <li class="breadcrumb-item"><%= link_to "Proposal Types", proposal_types_path %></li>
          <li class="breadcrumb-item"><%= link_to @proposal_type.name, proposal_type_proposal_forms_path(@proposal_type) %></li>
          <li class="breadcrumb-item active">Confirm Edit</li>
        </ol>
      </nav>
    </div>

    <div class="col-lg-12">
      <div class="alert alert-danger" role="alert">
        <strong>Attention:</strong> Editing this form will lock the following <%= pluralize(@stale_count, 'draft proposal') %>.
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <p class="mb-0">Editing an active form creates a new draft version and deactivates the current one (<strong><%= @proposal_form.title %></strong>, ID #<%= @proposal_form.id %>). The authors of these drafts will no longer be able to edit or submit them. They will see a message explaining that the call for proposals has been updated and asking them to start a new proposal. <strong>This cannot be undone from the UI.</strong></p>
        </div>
      </div>

      <div class="card mb-3" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-sm mb-0">
          <thead>
            <tr><th>Code</th><th>Title</th><th>Last modified</th></tr>
          </thead>
          <tbody>
            <% @proposals_to_lock.order(updated_at: :desc).each do |p| %>
              <tr>
                <td><%= link_to p.code, submitted_proposal_path(p), target: '_blank' %></td>
                <td><%= p.title %></td>
                <td><%= p.updated_at.strftime("%Y-%m-%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="d-flex gap-2">
        <%= link_to "Confirm — edit form and lock #{@stale_count} draft proposal(s)",
              edit_proposal_type_proposal_form_path(@proposal_type, @proposal_form, confirmed: 1),
              class: 'btn btn-danger' %>
        <%= link_to "Cancel", proposal_type_proposal_forms_path(@proposal_type), class: 'btn btn-secondary' %>
      </div>
    </div>
  </div>
</main>
