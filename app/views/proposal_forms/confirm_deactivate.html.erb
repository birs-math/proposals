<main class="content">
  <div class="container-fluid">
    <div class="header">
      <h1 class="header-title">Confirm Deactivation</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Dashboard", dashboards_path %></li>
          <li class="breadcrumb-item"><%= link_to "Proposal Types", proposal_types_path %></li>
          <li class="breadcrumb-item"><%= link_to @proposal_type.name, proposal_type_proposal_forms_path(@proposal_type) %></li>
          <li class="breadcrumb-item active">Confirm Deactivation</li>
        </ol>
      </nav>
    </div>

    <div class="col-lg-12">
      <div class="alert alert-danger" role="alert">
        <strong>Attention:</strong> Deactivating this form will lock the following <%= pluralize(@stale_count, 'draft proposal') %>.
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <p class="mb-0">Deactivating <strong><%= @proposal_form.title %></strong> (ID #<%= @proposal_form.id %>) will prevent the authors of these drafts from editing or submitting them. They will see a message explaining that the call for proposals has been updated and asking them to start a new proposal. <strong>This cannot be undone from the UI.</strong></p>
        </div>
      </div>

      <div class="card mb-3">
        <table class="table table-sm mb-0">
          <thead>
            <tr><th>Code</th><th>Title</th><th>Last modified</th></tr>
          </thead>
          <tbody>
            <% @proposals_to_lock.order(updated_at: :desc).each do |p| %>
              <tr>
                <td><%= link_to p.code, submitted_proposal_path(p), target: '_blank' %></td>
                <td><%= p.title %></td>
                <td><%= p.updated_at.strftime("%Y-%m-%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= form_with url: @confirm_url, method: @confirm_method, data: { turbo: false } do |f| %>
        <% (@pending_params || {}).each do |key, value| %>
          <%= hidden_field_tag "proposal_form[#{key}]", value %>
        <% end %>
        <%= hidden_field_tag :confirmed, 1 %>
        <div class="d-flex gap-2">
          <%= f.submit "Confirm — deactivate and lock #{@stale_count} draft proposal(s)", class: 'btn btn-danger' %>
          <%= link_to "Export CSV", export_stale_drafts_proposal_type_proposal_form_path(@proposal_type, @proposal_form), class: 'btn btn-outline-secondary' %>
          <%= link_to "Cancel", proposal_type_proposal_forms_path(@proposal_type), class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
  </div>
</main>
