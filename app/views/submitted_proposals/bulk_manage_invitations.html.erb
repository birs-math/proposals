<% content_for :title, "Bulk Manage Invitations" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Bulk Manage Invitations</h4>
          <p class="card-subtitle">Manage invitations for <%= pluralize(@proposals.count, 'proposal') %></p>
        </div>
        
        <div class="card-body">
          <% if @invites.any? %>
            <%= form_with url: bulk_update_invitations_submitted_proposals_path, method: :post, local: true, id: "bulk-invitations-form" do |form| %>
              <%= form.hidden_field :invite_ids, id: "selected-invite-ids" %>
              
              <div class="row mb-3">
                <div class="col-md-12">
                  <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll()">Select All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelection()">Clear Selection</button>
                  </div>
                  <span id="selection-count" class="ms-3 text-muted">0 selected</span>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead>
                    <tr>
                      <th width="5%">
                        <input type="checkbox" id="select-all-checkbox" onchange="toggleAll(this)">
                      </th>
                      <th>Proposal Code</th>
                      <th>Proposal Title</th>
                      <th>Invitee Name</th>
                      <th>Email</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th>Invited Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @invites.each do |invite| %>
                      <tr>
                        <td>
                          <input type="checkbox" class="invite-checkbox" value="<%= invite.id %>" 
                                 onchange="updateSelection()">
                        </td>
                        <td><%= invite.proposal.code %></td>
                        <td><%= truncate(invite.proposal.title, length: 50) %></td>
                        <td><%= invite.person.full_name %></td>
                        <td><%= invite.email %></td>
                        <td>
                          <span class="badge bg-secondary"><%= invite.invited_as %></span>
                        </td>
                        <td>
                          <span class="badge bg-<%= invite_status_color(invite.status) %>">
                            <%= invite.status.humanize %>
                          </span>
                        </td>
                        <td><%= invite.created_at.strftime("%Y-%m-%d") %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <div class="row mt-4">
                <div class="col-md-12">
                  <div class="card">
                    <div class="card-header">
                      <h5>Bulk Actions</h5>
                    </div>
                    <div class="card-body">
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group">
                            <%= form.label :bulk_action, "Action to perform:", class: "form-label" %>
                            <%= form.select :bulk_action, [
                              ['Confirm Selected Invitations', 'confirm'],
                              ['Decline Selected Invitations', 'decline'],
                              ['Cancel Selected Invitations', 'cancel']
                            ], { prompt: 'Select an action...' }, { class: "form-select", required: true } %>
                          </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                          <div class="btn-group w-100">
                            <%= form.submit "Apply Action", class: "btn btn-primary", 
                                onclick: "return confirmBulkAction()", disabled: true, id: "apply-action-btn" %>
                            <%= link_to "Cancel", submitted_proposals_path, class: "btn btn-secondary" %>
                          </div>
                        </div>
                      </div>
                      
                      <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>Note:</strong> Select invitations using the checkboxes above, then choose an action to apply to all selected invitations.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle"></i>
              No invitations found for the selected proposals.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function selectAll() {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = true);
  document.getElementById('select-all-checkbox').checked = true;
  updateSelection();
}

function clearSelection() {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = false);
  document.getElementById('select-all-checkbox').checked = false;
  updateSelection();
}

function toggleAll(selectAllCheckbox) {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
  updateSelection();
}

function updateSelection() {
  const checkboxes = document.querySelectorAll('.invite-checkbox:checked');
  const selectedIds = Array.from(checkboxes).map(cb => cb.value);
  const count = selectedIds.length;
  
  document.getElementById('selected-invite-ids').value = selectedIds.join(',');
  document.getElementById('selection-count').textContent = count + ' selected';
  document.getElementById('apply-action-btn').disabled = count === 0;
  
  // Update select all checkbox state
  const allCheckboxes = document.querySelectorAll('.invite-checkbox');
  const selectAllCheckbox = document.getElementById('select-all-checkbox');
  
  if (count === 0) {
    selectAllCheckbox.indeterminate = false;
    selectAllCheckbox.checked = false;
  } else if (count === allCheckboxes.length) {
    selectAllCheckbox.indeterminate = false;
    selectAllCheckbox.checked = true;
  } else {
    selectAllCheckbox.indeterminate = true;
  }
}

function confirmBulkAction() {
  const selectedCount = document.querySelectorAll('.invite-checkbox:checked').length;
  const action = document.getElementById('bulk_manage_invitations_bulk_action').value;
  
  if (selectedCount === 0) {
    alert('Please select at least one invitation.');
    return false;
  }
  
  if (!action) {
    alert('Please select an action to perform.');
    return false;
  }
  
  return confirm(`Are you sure you want to ${action} ${selectedCount} invitation(s)?`);
}

// Initialize selection state on page load
document.addEventListener('DOMContentLoaded', function() {
  updateSelection();
});
</script>

<style>
.invite-status-pending { background-color: #ffc107; }
.invite-status-confirmed { background-color: #28a745; }
.invite-status-declined { background-color: #dc3545; }
.invite-status-cancelled { background-color: #6c757d; }
</style>