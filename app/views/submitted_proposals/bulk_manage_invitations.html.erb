<% content_for :title, "Bulk Manage Invitations" %>

<div class="container-fluid">
  <!-- Blue Header Section - Moved down 50px -->
  <div class="row" style="margin-top: 50px;">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h4 class="card-title mb-0">
            <i class="fas fa-users-cog"></i> Bulk Manage Invitations
          </h4>
          <p class="card-subtitle mb-0 mt-2">
            Manage invitations for <%= pluralize(@proposals.count, 'proposal') %>
            <% if @proposals.any? %>
              - Codes: <%= @proposals.limit(3).pluck(:code).join(', ') %><%= ', ...' if @proposals.count > 3 %>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- White Content Area - Moved 100px down -->
  <div class="row" style="margin-top: 100px;">
    <div class="col-12">
      <div class="card">
        <div class="card-body bg-white">
          <!-- Flash Messages Section - In White Content Area -->
          <% if notice %>
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
              <i class="fas fa-check-circle"></i> <%= notice %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <% if alert %>
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
              <i class="fas fa-exclamation-triangle"></i> <%= alert %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <% if @invites.any? %>
            <!-- Category Filtering Tabs -->
            <div class="row mb-4">
              <div class="col-12">
                <ul class="nav nav-tabs" id="inviteCategories" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all-invites" type="button" role="tab">
                      All Invitations (<%= @invites.count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending-invites" type="button" role="tab">
                      <span class="badge bg-warning">Pending</span> (<%= @invites.where('invites.status = ?', 'pending').count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed-invites" type="button" role="tab">
                      <span class="badge bg-success">Confirmed</span> (<%= @invites.where('invites.status = ?', 'confirmed').count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="expired-tab" data-bs-toggle="tab" data-bs-target="#expired-invites" type="button" role="tab">
                      <span class="badge bg-danger">Expired</span> (<%= @invites.where('invites.deadline_date < ? AND invites.status = ?', Date.current, 'pending').count %>)
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <%= form_with url: bulk_update_invitations_submitted_proposals_path, method: :post, local: true, id: "bulk-invitations-form" do |form| %>
              <%= form.hidden_field :invite_ids, id: "selected-invite-ids" %>
              
              <!-- Smart Bulk Actions -->
              <div class="row mb-3">
                <div class="col-md-8">
                  <div class="btn-group me-3" role="group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll()">
                      <i class="fas fa-check-square"></i> Select All
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelection()">
                      <i class="fas fa-square"></i> Clear Selection
                    </button>
                  </div>
                  <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-warning" onclick="selectExpired()">
                      <i class="fas fa-clock"></i> Select Expired
                    </button>
                    <button type="button" class="btn btn-sm btn-info" onclick="selectPending()">
                      <i class="fas fa-hourglass-half"></i> Select Pending
                    </button>
                  </div>
                </div>
                <div class="col-md-4 text-end">
                  <span id="selection-count" class="text-muted">0 selected</span>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead>
                    <tr>
                      <th width="5%">
                        <input type="checkbox" id="select-all-checkbox" onchange="toggleAll(this)">
                      </th>
                      <th>Proposal Code</th>
                      <th>Proposal Title</th>
                      <th>Invitee Name</th>
                      <th>Email</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th>Deadline</th>
                      <th>Invited Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @invites.each do |invite| %>
                      <% 
                        is_expired = invite.deadline_date && invite.deadline_date < Date.current && invite.status == 'pending'
                        row_class = is_expired ? 'table-danger' : ''
                      %>
                      <tr class="<%= row_class %>" data-status="<%= invite.status %>" data-expired="<%= is_expired %>">
                        <td>
                          <input type="checkbox" class="invite-checkbox" value="<%= invite.id %>" 
                                 onchange="updateSelection()">
                        </td>
                        <td><%= invite.proposal.code %></td>
                        <td><%= truncate(invite.proposal.title, length: 50) %></td>
                        <td><%= invite.person.full_name %></td>
                        <td><%= invite.email %></td>
                        <td>
                          <span class="badge bg-secondary"><%= invite.invited_as %></span>
                        </td>
                        <td>
                          <span class="badge bg-<%= invite_status_color(invite.status) %>">
                            <%= invite.status.humanize %>
                            <% if is_expired %>
                              <i class="fas fa-clock ms-1" title="Expired"></i>
                            <% end %>
                          </span>
                        </td>
                        <td>
                          <% if invite.deadline_date %>
                            <%= invite.deadline_date.strftime("%Y-%m-%d") %>
                            <% if is_expired %>
                              <small class="text-danger d-block">
                                <i class="fas fa-exclamation-triangle"></i> Expired
                              </small>
                            <% end %>
                          <% else %>
                            <span class="text-muted">No deadline</span>
                          <% end %>
                        </td>
                        <td><%= invite.created_at.strftime("%Y-%m-%d") %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <div class="row mt-4">
                <div class="col-md-12">
                  <div class="card">
                    <div class="card-header">
                      <h5>Bulk Actions</h5>
                    </div>
                    <div class="card-body">
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group">
                            <%= form.label :bulk_action, "Action to perform:", class: "form-label" %>
                            <%= form.select :bulk_action, [
                              ['Confirm Selected Invitations', 'confirm'],
                              ['Decline Selected Invitations', 'decline'],
                              ['Cancel Selected Invitations', 'cancel']
                            ], { prompt: 'Select an action...' }, { class: "form-select", required: true } %>
                          </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                          <div class="btn-group w-100">
                            <%= form.submit "Apply Action", class: "btn btn-primary", 
                                onclick: "return confirmBulkAction()", disabled: true, id: "apply-action-btn" %>
                            <%= link_to "Cancel", submitted_proposals_path, class: "btn btn-secondary" %>
                          </div>
                        </div>
                      </div>
                      
                      <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>Note:</strong> Select invitations using the checkboxes above, then choose an action to apply to all selected invitations.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle"></i>
              No invitations found for the selected proposals.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function selectAll() {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = true);
  document.getElementById('select-all-checkbox').checked = true;
  updateSelection();
}

function clearSelection() {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = false);
  document.getElementById('select-all-checkbox').checked = false;
  updateSelection();
}

function toggleAll(selectAllCheckbox) {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
  updateSelection();
}

function updateSelection() {
  const checkboxes = document.querySelectorAll('.invite-checkbox:checked');
  const selectedIds = Array.from(checkboxes).map(cb => cb.value);
  const count = selectedIds.length;
  
  document.getElementById('selected-invite-ids').value = selectedIds.join(',');
  document.getElementById('selection-count').textContent = count + ' selected';
  document.getElementById('apply-action-btn').disabled = count === 0;
  
  // Update select all checkbox state
  const allCheckboxes = document.querySelectorAll('.invite-checkbox');
  const selectAllCheckbox = document.getElementById('select-all-checkbox');
  
  if (count === 0) {
    selectAllCheckbox.indeterminate = false;
    selectAllCheckbox.checked = false;
  } else if (count === allCheckboxes.length) {
    selectAllCheckbox.indeterminate = false;
    selectAllCheckbox.checked = true;
  } else {
    selectAllCheckbox.indeterminate = true;
  }
}

function selectExpired() {
  const expiredRows = document.querySelectorAll('tr[data-expired="true"]');
  expiredRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}

function selectPending() {
  const pendingRows = document.querySelectorAll('tr[data-status="pending"]');
  pendingRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}

function confirmBulkAction() {
  const selectedCount = document.querySelectorAll('.invite-checkbox:checked').length;
  const action = document.getElementById('bulk_manage_invitations_bulk_action').value;
  
  if (selectedCount === 0) {
    alert('Please select at least one invitation.');
    return false;
  }
  
  if (!action) {
    alert('Please select an action to perform.');
    return false;
  }
  
  return confirm(`Are you sure you want to ${action} ${selectedCount} invitation(s)?`);
}

// Initialize selection state on page load
document.addEventListener('DOMContentLoaded', function() {
  updateSelection();
});
</script>

<style>
.invite-status-pending { background-color: #ffc107; }
.invite-status-confirmed { background-color: #28a745; }
.invite-status-declined { background-color: #dc3545; }
.invite-status-cancelled { background-color: #6c757d; }
</style>