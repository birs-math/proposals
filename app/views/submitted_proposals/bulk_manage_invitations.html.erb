<% content_for :title, "Bulk Manage Invitations" %>

<div class="container-fluid">
  <!-- Blue Header Section - Moved down 50px -->
  <div class="row" style="margin-top: 50px;">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h4 class="card-title mb-0 text-white">
            <i class="fas fa-users-cog"></i> Bulk Manage Invitations
          </h4>
          <p class="card-subtitle mb-0 mt-2 text-white">
            Manage invitations for <%= pluralize(@proposals.count, 'proposal') %>
            <% if @proposals.any? %>
              - Codes: <%= @proposals.distinct.limit(3).pluck(:code).join(', ') %><%= ', ...' if @proposals.count > 3 %>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- White Content Area - Moved 100px down -->
  <div class="row" style="margin-top: 100px;">
    <div class="col-12">
      <div class="card">
        <div class="card-body bg-white">
          <!-- Flash Messages Section - In White Content Area -->
          <% if notice %>
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
              <i class="fas fa-check-circle"></i> <%= notice %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <% if alert %>
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
              <i class="fas fa-exclamation-triangle"></i> <%= alert %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <% if @invites.any? %>
            <!-- Category Filtering Tabs -->
            <div class="row mb-4">
              <div class="col-12">
                <ul class="nav nav-tabs" id="inviteCategories" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all-invites" type="button" role="tab">
                      All Invitations (<%= @invites.count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending-invites" type="button" role="tab">
                      <span class="badge bg-warning text-dark">Pending</span> (<%= @invites.pending.count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed-invites" type="button" role="tab">
                      <span class="badge bg-success text-white">Confirmed</span> (<%= @invites.confirmed.count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="cancelled-tab" data-bs-toggle="tab" data-bs-target="#cancelled-invites" type="button" role="tab">
                      <span class="badge bg-secondary text-white">Cancelled</span> (<%= @invites.cancelled.count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="declined-tab" data-bs-toggle="tab" data-bs-target="#declined-invites" type="button" role="tab">
                      <span class="badge bg-danger text-white">Declined</span> (<%= @invites.declined.count %>)
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="expired-tab" data-bs-toggle="tab" data-bs-target="#expired-invites" type="button" role="tab">
                      <span class="badge bg-dark text-white">Expired</span> (<%= @invites.where('invites.deadline_date < ? AND invites.status = ?', Date.current, 0).count %>)
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <%= form_with url: bulk_update_invitations_submitted_proposals_path, method: :post, local: false, id: "bulk-invitations-form" do |form| %>
              <%= form.hidden_field :invite_ids, id: "selected-invite-ids" %>
              
              <!-- Smart Bulk Actions -->
              <div class="row mb-3">
                <div class="col-md-8">
                  <div class="btn-group me-3" role="group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll()">
                      <i class="fas fa-check-square"></i> Select All
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelection()">
                      <i class="fas fa-square"></i> Clear Selection
                    </button>
                  </div>
                  <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-warning text-dark" onclick="selectPending()">
                      <i class="fas fa-hourglass-half"></i> Select Pending
                    </button>
                    <button type="button" class="btn btn-sm btn-success" onclick="selectConfirmed()">
                      <i class="fas fa-check"></i> Select Confirmed
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="selectCancelled()">
                      <i class="fas fa-ban"></i> Select Cancelled
                    </button>
                    <button type="button" class="btn btn-sm btn-danger" onclick="selectDeclined()">
                      <i class="fas fa-times"></i> Select Declined
                    </button>
                    <button type="button" class="btn btn-sm btn-dark" onclick="selectExpired()">
                      <i class="fas fa-clock"></i> Select Expired
                    </button>
                  </div>
                </div>
                <div class="col-md-4 text-end">
                  <span id="selection-count" class="text-muted">0 selected</span>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead>
                    <tr>
                      <th width="5%">
                        <input type="checkbox" id="select-all-checkbox" onchange="toggleAll(this)">
                      </th>
                      <th>Proposal Code</th>
                      <th>Proposal Title</th>
                      <th>Invitee Name</th>
                      <th>Email</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th>Deadline</th>
                      <th>Invited Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @invites.each do |invite| %>
                      <% 
                        is_expired = invite.deadline_date && invite.deadline_date < Date.current && invite.status == 'pending'
                        row_class = is_expired ? 'table-danger' : ''
                      %>
                      <tr class="<%= row_class %>" data-status="<%= invite.status %>" data-expired="<%= is_expired %>">
                        <td>
                          <input type="checkbox" class="invite-checkbox" value="<%= invite.id %>" 
                                 onchange="updateSelection()">
                        </td>
                        <td><%= invite.proposal.code %></td>
                        <td><%= truncate(invite.proposal.title, length: 50) %></td>
                        <td><%= invite.person.fullname %></td>
                        <td><%= invite.email %></td>
                        <td>
                          <span class="badge bg-secondary"><%= invite.invited_as %></span>
                        </td>
                        <td>
                          <span class="badge bg-<%= invite_status_color(invite.status) %>">
                            <%= invite.status.humanize %>
                            <% if is_expired %>
                              <i class="fas fa-clock ms-1" title="Expired"></i>
                            <% end %>
                          </span>
                        </td>
                        <td>
                          <% if invite.deadline_date %>
                            <%= invite.deadline_date.strftime("%Y-%m-%d") %>
                            <% if is_expired %>
                              <small class="text-danger d-block">
                                <i class="fas fa-exclamation-triangle"></i> Expired
                              </small>
                            <% end %>
                          <% else %>
                            <span class="text-muted">No deadline</span>
                          <% end %>
                        </td>
                        <td><%= invite.created_at.strftime("%Y-%m-%d") %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <div class="row mt-4">
                <div class="col-md-12">
                  <div class="card">
                    <div class="card-header">
                      <h5>Bulk Actions</h5>
                    </div>
                    <div class="card-body">
                      <div class="row">
                        <div class="col-md-8">
                          <div class="form-group">
                            <label class="form-label">Choose action for selected invitations:</label>
                            <div class="btn-group-vertical d-grid gap-2 mt-2" role="group">
                              <input type="radio" class="btn-check" name="bulk_action" id="confirm_action" value="confirm" autocomplete="off">
                              <label class="btn btn-outline-success text-start" for="confirm_action">
                                <i class="fas fa-check me-2"></i> Confirm Selected Invitations
                              </label>
                              
                              <input type="radio" class="btn-check" name="bulk_action" id="decline_action" value="decline" autocomplete="off">
                              <label class="btn btn-outline-danger text-start" for="decline_action">
                                <i class="fas fa-times me-2"></i> Decline Selected Invitations
                              </label>
                              
                              <input type="radio" class="btn-check" name="bulk_action" id="cancel_action" value="cancel" autocomplete="off">
                              <label class="btn btn-outline-secondary text-start" for="cancel_action">
                                <i class="fas fa-ban me-2"></i> Cancel Selected Invitations
                              </label>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                          <div class="d-grid gap-2 w-100">
                            <button type="submit" class="btn btn-primary btn-lg" disabled id="apply-action-btn">
                              <i class="fas fa-play me-2"></i> Apply Action
                            </button>
                            <%= link_to submitted_proposals_path, class: "btn btn-outline-secondary" do %>
                              <i class="fas fa-arrow-left me-2"></i> Back to Proposals
                            <% end %>
                          </div>
                        </div>
                      </div>
                      
                      <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>Quick Actions:</strong> Select invitations above, choose an action with one click, then apply.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle"></i>
              No invitations found for the selected proposals.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function selectAll() {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = true);
  document.getElementById('select-all-checkbox').checked = true;
  updateSelection();
}

function clearSelection() {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = false);
  document.getElementById('select-all-checkbox').checked = false;
  updateSelection();
}

function toggleAll(selectAllCheckbox) {
  const checkboxes = document.querySelectorAll('.invite-checkbox');
  checkboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
  updateSelection();
}

function updateSelection() {
  const checkboxes = document.querySelectorAll('.invite-checkbox:checked');
  const selectedIds = Array.from(checkboxes).map(cb => cb.value);
  const count = selectedIds.length;
  
  document.getElementById('selected-invite-ids').value = selectedIds.join(',');
  document.getElementById('selection-count').textContent = count + ' selected';
  
  // Enable apply button only if both invitations are selected AND an action is chosen
  const selectedAction = document.querySelector('input[name="bulk_action"]:checked');
  document.getElementById('apply-action-btn').disabled = count === 0 || !selectedAction;
  
  // Update select all checkbox state
  const allCheckboxes = document.querySelectorAll('.invite-checkbox');
  const selectAllCheckbox = document.getElementById('select-all-checkbox');
  
  if (count === 0) {
    selectAllCheckbox.indeterminate = false;
    selectAllCheckbox.checked = false;
  } else if (count === allCheckboxes.length) {
    selectAllCheckbox.indeterminate = false;
    selectAllCheckbox.checked = true;
  } else {
    selectAllCheckbox.indeterminate = true;
  }
}

function selectExpired() {
  const expiredRows = document.querySelectorAll('tr[data-expired="true"]');
  expiredRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}

function selectPending() {
  const pendingRows = document.querySelectorAll('tr[data-status="pending"]');
  pendingRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}

function selectConfirmed() {
  const confirmedRows = document.querySelectorAll('tr[data-status="confirmed"]');
  confirmedRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}

function selectCancelled() {
  const cancelledRows = document.querySelectorAll('tr[data-status="cancelled"]');
  cancelledRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}

function selectDeclined() {
  const declinedRows = document.querySelectorAll('tr[data-status="declined"]');
  declinedRows.forEach(row => {
    const checkbox = row.querySelector('.invite-checkbox');
    if (checkbox) checkbox.checked = true;
  });
  updateSelection();
}


// Initialize selection state on page load
document.addEventListener('DOMContentLoaded', function() {
  updateSelection();
  
  // Add event listeners to radio buttons to enable/disable apply button
  const radioButtons = document.querySelectorAll('input[name="bulk_action"]');
  radioButtons.forEach(radio => {
    radio.addEventListener('change', updateSelection);
  });
  
  // Handle AJAX form submission
  const form = document.getElementById('bulk-invitations-form');
  if (form) {
    form.addEventListener('ajax:success', function(event) {
      const response = event.detail[0];
      if (response.message) {
        // Show success message
        toastr.success(response.message);
        
        // Refresh the page content to show updated statuses
        setTimeout(function() {
          window.location.reload();
        }, 1500);
      }
    });
    
    form.addEventListener('ajax:error', function(event) {
      const response = event.detail[0];
      toastr.error('Error updating invitations: ' + (response.message || 'Unknown error'));
    });
  }
});
</script>

<style>
/* Ensure consistent text colors for badges */
.badge.bg-warning { 
  color: #000 !important; /* Dark text on yellow background */
}
.badge.bg-success,
.badge.bg-secondary, 
.badge.bg-danger,
.badge.bg-dark {
  color: #fff !important; /* White text on dark backgrounds */
}

/* Expired invitation rows */
.table-danger {
  background-color: rgba(220, 53, 69, 0.1) !important;
}

/* Status-specific row highlighting */
.invite-status-pending { background-color: #ffc107; }
.invite-status-confirmed { background-color: #28a745; }
.invite-status-declined { background-color: #dc3545; }
.invite-status-cancelled { background-color: #6c757d; }

/* Radio button styling - show selected state with solid colors */
.btn-check:checked + .btn-outline-success {
  background-color: #198754 !important;
  border-color: #198754 !important;
  color: white !important;
}

.btn-check:checked + .btn-outline-danger {
  background-color: #dc3545 !important;
  border-color: #dc3545 !important;
  color: white !important;
}

.btn-check:checked + .btn-outline-secondary {
  background-color: #6c757d !important;
  border-color: #6c757d !important;
  color: white !important;
}

/* Hover effects for better interaction feedback */
.btn-outline-success:hover {
  background-color: #198754;
  border-color: #198754;
  color: white;
}

.btn-outline-danger:hover {
  background-color: #dc3545;
  border-color: #dc3545;
  color: white;
}

.btn-outline-secondary:hover {
  background-color: #6c757d;
  border-color: #6c757d;
  color: white;
}
</style>