<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h4 class="card-title mb-0">Invitation Expired</h4>
        </div>
        <div class="card-body">
          <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i>
            <strong>This invitation has expired.</strong>
          </div>
          
          <p>The invitation to participate in <strong><%= @proposal.title %></strong> expired on 
             <strong><%= @invite.deadline_date.strftime('%B %d, %Y') %></strong>.</p>
          
          <% if @invite.can_be_resent? %>
            <p>If you are still interested in participating, please contact the lead organizer 
               or the BIRS staff for assistance.</p>
          <% end %>

          <div class="contact-info mt-4">
            <p><strong>Lead Organizer:</strong> <%= @proposal.lead_organizer.fullname %></p>
            <p><strong>Email:</strong> <%= @proposal.lead_organizer.email %></p>
          </div>

          <div class="text-center mt-4">
            <%= link_to "Return to BIRS", root_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>